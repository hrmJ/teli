{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "types": [
      "node"
    ],
    "verbatimModulesyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true
  }
}
